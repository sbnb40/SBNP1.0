-- 🔥 WALLHACK
local function ClearESP()
    for _, obj in ipairs(espObjects) do
        pcall(function()
            obj:Destroy()
        end)
    end
    espObjects = {}
end

local function CreateESP(character, isEnemy)
    if not character or not character.Parent then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")
    
    if not rootPart or not head then return end
    
    -- Caixa
    local box = Instance.new("BoxHandleAdornment")
    box.Adornee = rootPart
    box.Size = Vector3.new(2.5, 4, 1.8)
    box.Color3 = isEnemy and Color3.new(1, 0, 0) or Color3.new(0, 1, 0)
    box.Transparency = 0.4
    box.ZIndex = 10
    box.AlwaysOnTop = true
    box.Parent = rootPart
    table.insert(espObjects, box)
    
    -- Nome
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 100, 0, 25)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.MaxDistance = 1000
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = "●"
    textLabel.TextColor3 = isEnemy and Color3.new(1, 0, 0) or Color3.new(0, 1, 0)
    textLabel.TextSize = 18
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0.3
    textLabel.Parent = billboard
    table.insert(espObjects, billboard)
    
    -- Esqueleto
    local joints = {
        {"Head", "UpperTorso"},
        {"UpperTorso", "LowerTorso"},
        {"LeftUpperArm", "LeftLowerArm"},
        {"RightUpperArm", "RightLowerArm"},
        {"LeftUpperLeg", "LeftLowerLeg"},
        {"RightUpperLeg", "RightLowerLeg"}
    }
    
    for _, joint in ipairs(joints) do
        local part1 = character:FindFirstChild(joint[1])
        local part2 = character:FindFirstChild(joint[2])
        
        if part1 and part1:IsA("BasePart") and part2 and part2:IsA("BasePart") then
            local pos1 = part1.Position
            local pos2 = part2.Position
            local distance = (pos1 - pos2).Magnitude
            
            if distance > 0.5 and distance < 20 then
                local line = Instance.new("Part")
                line.Name = "ESP_Skeleton"
                line.Size = Vector3.new(0.1, 0.1, distance)
                line.Position = (pos1 + pos2) / 2
                line.Anchored = true
                line.CanCollide = false
                line.CastShadow = false
                line.Material = Enum.Material.Neon
                line.Transparency = 0.2
                line.Color = isEnemy and Color3.new(1, 0.3, 0.3) or Color3.new(0.3, 1, 0.3)
                line.TopSurface = Enum.SurfaceType.Smooth
                line.BottomSurface = Enum.SurfaceType.Smooth
                
                local direction = (pos2 - pos1).Unit
                line.CFrame = CFrame.lookAt((pos1 + pos2) / 2, ((pos1 + pos2) / 2) + direction)
                
                line.Parent = workspace
                table.insert(espObjects, line)
            end
        end
    end
    
    -- Cabeça
    local circle = Instance.new("Part")
    circle.Name = "ESP_Head"
    circle.Shape = Enum.PartType.Ball
    circle.Size = Vector3.new(0.8, 0.8, 0.8)
    circle.Position = head.Position
    circle.Anchored = true
    circle.CanCollide = false
    circle.CastShadow = false
    circle.Material = Enum.Material.Neon
    circle.Transparency = 0.3
    circle.Color = isEnemy and Color3.new(1, 0, 0) or Color3.new(0, 1, 0)
    circle.Parent = workspace
    table.insert(espObjects, circle)
end

local function ToggleWallhack(active)
    WallhackActive = active
    ClearESP()
    
    if not active then return end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            CreateESP(plr.Character, true)
        end
    end
end

