-- 🎯 AIMBOT
local function UpdateWeaponAim()
    if not isAiming or not scriptLiberado then return end -- TRAVA DE SEGURANÇA CASO A SENHA NÃO SEJA INSERIDA

    local camera = workspace.CurrentCamera
    if not camera then return end

    local bestTarget = nil
    local bestScore = math.huge
    local char = player.Character
    if not char then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local enemyChar = plr.Character
            local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
            local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")

            if humanoid and enemyRoot and enemyRoot.Parent then
                if humanoid.Health > 0 then
                    if player.Team == nil or player.Team ~= plr.Team then
                        
                        local fromPos = camera.CFrame.Position
                        local toPos = enemyRoot.Position
                        local distance = (toPos - fromPos).Magnitude
                        
                        local lookVector = camera.CFrame.LookVector
                        local directionToEnemy = (toPos - fromPos).Unit
                        local dotProduct = lookVector:Dot(directionToEnemy)
                        
                        if distance < AIM_DISTANCE and dotProduct > 0 then
                            if enemyRoot.Name == "HumanoidRootPart" then
                                local score = distance - (dotProduct * 2000)
                                if score < bestScore then
                                    bestScore = score
                                    bestTarget = enemyRoot
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    if bestTarget then
        local currentPos = camera.CFrame.Position
        local targetPos = bestTarget.Position
        camera.CFrame = CFrame.lookAt(currentPos, targetPos)
    end
end

